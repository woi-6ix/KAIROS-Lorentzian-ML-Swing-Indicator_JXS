// GREEKS STRIKE ENGINE
// FBB RED / GREEN TOUCH & CROSS ENGINE
//
// Detects ALL bullish interactions with the GREEN outer FBB band
// and ALL bearish interactions with the RED outer FBB band.
//
// No candle-strength filter.
// No consecutive-candle requirement.
// Wick touches count.
// Small crosses count.
// Signals only use GREEN and RED outer bands.
//@version=6
indicator(
     "GREEKS Strike Engine {JXS_918}",
     shorttitle = "GREEKS",
     overlay = true,
     max_labels_count = 500,
     max_lines_count = 500)
//=====================================================================================================================
// COLORS
//=====================================================================================================================
GOLD       = #FFFFFF
SILVER     = #C0C0C0
TEAL       = #009988
ROSE       = #CC3311
PINK       = #787B86
NAVY       = #131722
DARK_NAVY  = #222938
LIGHT_GRAY = #C0C0C0
WHITE      = #FFFFFF
//=====================================================================================================================
// SESSION
//=====================================================================================================================
TIMEZONE        = "America/New_York"
TRADING_SESSION = "0930-1500:23456"
//=====================================================================================================================
// INPUT GROUPS
//=====================================================================================================================
FBB_GROUP     = "Fibonacci Bollinger Bands"
SIGNAL_GROUP  = "Red / Green Signals"
DISPLAY_GROUP = "Chart Display"
DASH_GROUP    = "Engine Dashboard"
//=====================================================================================================================
// FBB INPUTS
//=====================================================================================================================
fbbLengthInput = input.int(
     200,
     "FBB Length",
     minval = 1,
     group = FBB_GROUP)
fbbSourceInput = input.source(
     hlc3,
     "FBB Source",
     group = FBB_GROUP)
fbbMultiplierInput = input.float(
     3.0,
     "Deviation Multiplier",
     minval = 0.001,
     maxval = 50.0,
     step = 0.1,
     group = FBB_GROUP)
//=====================================================================================================================
// SIGNAL INPUTS
//=====================================================================================================================
enableGreenSignalInput = input.bool(
     true,
     "Bullish Green-Band Touch / Cross",
     tooltip = "Marks ANY bullish candle whose range touches or crosses the green outer FBB band.",
     group = SIGNAL_GROUP)
enableRedSignalInput = input.bool(
     true,
     "Bearish Red-Band Touch / Cross",
     tooltip = "Marks ANY bearish candle whose range touches or crosses the red outer FBB band.",
     group = SIGNAL_GROUP)
sessionOnlyInput = input.bool(
     true,
     "Only Signal During 9:30–3:00 ET",
     group = SIGNAL_GROUP)
//=====================================================================================================================
// DISPLAY INPUTS
//=====================================================================================================================
showInnerBandsInput = input.bool(
     true,
     "Show Inner Fibonacci Bands",
     group = DISPLAY_GROUP)
showBasisInput = input.bool(
     true,
     "Show VWMA Basis",
     group = DISPLAY_GROUP)
showSignalMarkersInput = input.bool(
     true,
     "Show Signal Markers",
     group = DISPLAY_GROUP)
showDetailedLabelsInput = input.bool(
     false,
     "Show Detailed Signal Labels",
     tooltip = "Leave disabled if you want a cleaner chart with many signals.",
     group = DISPLAY_GROUP)
highlightSignalBarsInput = input.bool(
     true,
     "Highlight Signal Candles",
     group = DISPLAY_GROUP)
//=====================================================================================================================
// DASHBOARD INPUTS
//=====================================================================================================================
showDashboardInput = input.bool(
     true,
     "Show Engine Dashboard",
     group = DASH_GROUP)
dashboardPositionInput = input.string(
     "Top Right",
     "Dashboard Position",
     options = [
          "Top Right",
          "Top Left",
          "Bottom Right",
          "Bottom Left"],
     group = DASH_GROUP)
dashboardSizeInput = input.string(
     "Small",
     "Dashboard Text Size",
     options = [
          "Tiny",
          "Small",
          "Normal",
          "Large"],
     group = DASH_GROUP)
//=====================================================================================================================
// FIBONACCI BOLLINGER BANDS
//=====================================================================================================================
basis = ta.vwma(
     fbbSourceInput,
     fbbLengthInput)
deviation =
     fbbMultiplierInput *
     ta.stdev(
          fbbSourceInput,
          fbbLengthInput)
// Upper bands
upper0236 = basis + 0.236 * deviation
upper0382 = basis + 0.382 * deviation
upper0500 = basis + 0.500 * deviation
upper0618 = basis + 0.618 * deviation
upper0764 = basis + 0.764 * deviation
upper1000 = basis + 1.000 * deviation
// Lower bands
lower0236 = basis - 0.236 * deviation
lower0382 = basis - 0.382 * deviation
lower0500 = basis - 0.500 * deviation
lower0618 = basis - 0.618 * deviation
lower0764 = basis - 0.764 * deviation
lower1000 = basis - 1.000 * deviation
//=====================================================================================================================
// NEW YORK SESSION
//=====================================================================================================================
inTradingSession = not na(
     time(
          timeframe.period,
          TRADING_SESSION,
          TIMEZONE))
signalSessionAllowed =
     not sessionOnlyInput or
     inTradingSession
//=====================================================================================================================
// NEW YORK DAY
//=====================================================================================================================
newYorkDayKey =
     year(time, TIMEZONE) * 10000 +
     month(time, TIMEZONE) * 100 +
     dayofmonth(time, TIMEZONE)
newYorkDayStarted =
     ta.change(newYorkDayKey) != 0
//=====================================================================================================================
// BASIC CANDLE DIRECTION
//=====================================================================================================================
// No candle strength calculation is required.
//
// ANY green candle = bullish.
// ANY red candle   = bearish.
bullishCandle =
     close > open
bearishCandle =
     close < open
//=====================================================================================================================
// GREEN BAND INTERACTION
//=====================================================================================================================
//
// IMPORTANT:
//
// A candle touches the green band whenever the green band is located
// anywhere inside the candle's entire LOW-to-HIGH range.
//
// Therefore:
//
//     low <= lower1000
// AND
//     high >= lower1000
//
// This detects:
//
// 1. Full candle crosses
// 2. Wick crosses
// 3. Wick touches
// 4. Tiny crosses
// 5. Bounces from the band
// 6. Candles opening underneath and moving above
// 7. Candles opening above and dipping into the band
//
// Candle strength does NOT matter.
//=====================================================================================================================
greenBandTouched =
     low <= lower1000 and
     high >= lower1000
//=====================================================================================================================
// RED BAND INTERACTION
//=====================================================================================================================
redBandTouched =
     low <= upper1000 and
     high >= upper1000
//=====================================================================================================================
// FINAL SIGNALS
//=====================================================================================================================
// Bullish candle touching/crossing GREEN band.
bullishGreenSignal =
     enableGreenSignalInput and
     signalSessionAllowed and
     bullishCandle and
     greenBandTouched and
     barstate.isconfirmed
// Bearish candle touching/crossing RED band.
bearishRedSignal =
     enableRedSignalInput and
     signalSessionAllowed and
     bearishCandle and
     redBandTouched and
     barstate.isconfirmed
//=====================================================================================================================
// OPTIONAL EXACT CROSS INFORMATION
//=====================================================================================================================
//
// These variables classify HOW the interaction happened.
// They do NOT filter the main signals.
// Bullish candle started below green and traded through it.
bullishGreenFromBelow =
     bullishGreenSignal and
     open <= lower1000 and
     high >= lower1000
// Bullish candle dipped down into green and recovered.
bullishGreenBounce =
     bullishGreenSignal and
     open > lower1000 and
     low <= lower1000
// Bearish candle started above red and traded down through it.
bearishRedFromAbove =
     bearishRedSignal and
     open >= upper1000 and
     low <= upper1000
// Bearish candle pushed upward into red and rejected.
bearishRedRejection =
     bearishRedSignal and
     open < upper1000 and
     high >= upper1000
//=====================================================================================================================
// DAILY SIGNAL COUNTERS
//=====================================================================================================================
var int bullishGreenCount = 0
var int bearishRedCount   = 0
if newYorkDayStarted
    bullishGreenCount := 0
    bearishRedCount   := 0
if bullishGreenSignal
    bullishGreenCount += 1
if bearishRedSignal
    bearishRedCount += 1
//=====================================================================================================================
// LAST SIGNAL TRACKING
//=====================================================================================================================
var string lastSignalText  = "NONE"
var color  lastSignalColor = LIGHT_GRAY
var int    lastSignalBar   = na
if newYorkDayStarted
    lastSignalText  := "NONE"
    lastSignalColor := LIGHT_GRAY
    lastSignalBar   := na
if bullishGreenSignal
    lastSignalText  := "BULL GREEN"
    lastSignalColor := TEAL
    lastSignalBar   := bar_index
if bearishRedSignal
    lastSignalText  := "BEAR RED"
    lastSignalColor := ROSE
    lastSignalBar   := bar_index
barsSinceLastSignal =
     not na(lastSignalBar) ?
     bar_index - lastSignalBar :
     na
//=====================================================================================================================
// FBB DISPLAY
//=====================================================================================================================
// Neutral VWMA basis
basisPlot = plot(
     showBasisInput ? basis : na,
     "VWMA Basis",
     color = PINK,
     linewidth = 3)
//---------------------------------------------------------------------------------------------------------------------
// UPPER FIBONACCI BANDS
//---------------------------------------------------------------------------------------------------------------------
upper0236Plot = plot(
     showInnerBandsInput ? upper0236 : na,
     "Upper 0.236",
     color = color.new(WHITE, 45),
     linewidth = 1)
upper0382Plot = plot(
     showInnerBandsInput ? upper0382 : na,
     "Upper 0.382",
     color = color.new(WHITE, 42),
     linewidth = 1)
upper0500Plot = plot(
     showInnerBandsInput ? upper0500 : na,
     "Upper 0.500",
     color = color.new(WHITE, 38),
     linewidth = 1)
upper0618Plot = plot(
     showInnerBandsInput ? upper0618 : na,
     "Upper 0.618",
     color = color.new(WHITE, 34),
     linewidth = 1)
upper0764Plot = plot(
     upper0764,
     "Upper 0.764",
     color = color.new(ROSE, 45),
     linewidth = 1)
upper1000Plot = plot(
     upper1000,
     "Upper Red 1.000",
     color = ROSE,
     linewidth = 3)
//---------------------------------------------------------------------------------------------------------------------
// LOWER FIBONACCI BANDS
//---------------------------------------------------------------------------------------------------------------------
lower0236Plot = plot(
     showInnerBandsInput ? lower0236 : na,
     "Lower 0.236",
     color = color.new(WHITE, 45),
     linewidth = 1)
lower0382Plot = plot(
     showInnerBandsInput ? lower0382 : na,
     "Lower 0.382",
     color = color.new(WHITE, 42),
     linewidth = 1)
lower0500Plot = plot(
     showInnerBandsInput ? lower0500 : na,
     "Lower 0.500",
     color = color.new(WHITE, 38),
     linewidth = 1)
lower0618Plot = plot(
     showInnerBandsInput ? lower0618 : na,
     "Lower 0.618",
     color = color.new(WHITE, 34),
     linewidth = 1)
lower0764Plot = plot(
     lower0764,
     "Lower 0.764",
     color = color.new(TEAL, 45),
     linewidth = 1)
lower1000Plot = plot(
     lower1000,
     "Lower Green 1.000",
     color = TEAL,
     linewidth = 3)
//=====================================================================================================================
// EXTREME ZONE FILLS
//=====================================================================================================================
fill(
     upper1000Plot,
     upper0764Plot,
     title = "Upper Red Extreme Zone",
     color = color.new(ROSE, 91))
fill(
     lower1000Plot,
     lower0764Plot,
     title = "Lower Green Extreme Zone",
     color = color.new(TEAL, 91))
//=====================================================================================================================
// SIGNAL MARKERS
//=====================================================================================================================
// Every qualifying bullish GREEN-band interaction.
plotshape(
     showSignalMarkersInput and bullishGreenSignal,
     title = "Bullish Green Band Touch / Cross",
     text = "G L",
     location = location.belowbar,
     style = shape.labelup,
     size = size.small,
     color = TEAL,
     textcolor = WHITE)
// Every qualifying bearish RED-band interaction.
plotshape(
     showSignalMarkersInput and bearishRedSignal,
     title = "Bearish Red Band Touch / Cross",
     text = "G S",
     location = location.abovebar,
     style = shape.labeldown,
     size = size.small,
     color = ROSE,
     textcolor = WHITE)
//=====================================================================================================================
// SMALL SECONDARY TOUCH MARKERS
//=====================================================================================================================
// Green-band bounce/recovery marker.
plotshape(
     showSignalMarkersInput and bullishGreenBounce,
     title = "Bullish Green Bounce",
     style = shape.triangleup,
     location = location.belowbar,
     size = size.tiny,
     color = GOLD)
// Red-band rejection marker.
plotshape(
     showSignalMarkersInput and bearishRedRejection,
     title = "Bearish Red Rejection",
     style = shape.triangledown,
     location = location.abovebar,
     size = size.tiny,
     color = GOLD)
//=====================================================================================================================
// DETAILED LABELS
//=====================================================================================================================
atrValue = ta.atr(14)
if showDetailedLabelsInput and bullishGreenSignal
    signalType =
         bullishGreenBounce ?
         "GREEN BAND BOUNCE / TOUCH" :
         "GREEN BAND CROSS"
    label.new(
         bar_index,
         low - atrValue * 0.40,
         "▲ GREEKS\n" +
         "FBB SIGNAL\n" +
         "BULLISH\n" +
         signalType + "\n" +
         "GREEN: " +
         str.tostring(lower1000, format.mintick) + "\n" +
         "CLOSE: " +
         str.tostring(close, format.mintick),
         color = color.new(NAVY, 5),
         textcolor = TEAL,
         style = label.style_label_up,
         size = size.small)
if showDetailedLabelsInput and bearishRedSignal
    signalType =
         bearishRedRejection ?
         "RED BAND REJECTION / TOUCH" :
         "RED BAND CROSS"
    label.new(
         bar_index,
         high + atrValue * 0.40,
         "▼ GREEKS\n" +
         "FBB SIGNAL\n" +
         "BEARISH\n" +
         signalType + "\n" +
         "RED: " +
         str.tostring(upper1000, format.mintick) + "\n" +
         "CLOSE: " +
         str.tostring(close, format.mintick),
         color = color.new(NAVY, 5),
         textcolor = ROSE,
         style = label.style_label_down,
         size = size.small)
//=====================================================================================================================
// SIGNAL CANDLE COLORS
//=====================================================================================================================
signalBarColor =
     bullishGreenSignal ?
     TEAL :
     bearishRedSignal ?
     ROSE :
     na
barcolor(
     highlightSignalBarsInput ?
     signalBarColor :
     na)
//=====================================================================================================================
// DASHBOARD AND FOOTER TYPOGRAPHY
// ============================================================================
string dashboardFontInput = input.string("Default", "Dashboard Font Family", options=["Default", "Monospace"], group=DASH_GROUP)
string FOOTER_GROUP = "Bottom Watermark"
bool showFooterInput = input.bool(true, "Show Bottom Watermark", group=FOOTER_GROUP)
string footerTextInput = input.string("GREEKS · FBB · JXS_918", "Bottom Text", group=FOOTER_GROUP)
int footerSizeInput = input.int(14, "Bottom Font Size", minval=8, maxval=36, group=FOOTER_GROUP)
string footerFontInput = input.string("Default", "Bottom Font Family", options=["Default", "Monospace"], group=FOOTER_GROUP)
color footerColorInput = input.color(color.new(color.silver, 45), "Bottom Text Color", group=FOOTER_GROUP)

f_dashboard_position() =>
    switch dashboardPositionInput
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        => position.top_right

f_dashboard_size() =>
    switch dashboardSizeInput
        "Tiny" => size.tiny
        "Normal" => size.normal
        "Large" => size.large
        => size.small

string dashboardFont = dashboardFontInput == "Monospace" ? font.family_monospace : font.family_default
string footerFont = footerFontInput == "Monospace" ? font.family_monospace : font.family_default
color dashboardBackground = color.new(#131722, 10)
color dashboardHeader = color.new(#222938, 0)
color dashboardBorder = color.new(color.gray, 65)

f_greeks_row(table target, int row, string caption, string value, color valueColor, string textSize, string fontFamily) =>
    table.cell(target, 0, row, caption, text_color=color.silver, text_halign=text.align_left, text_size=textSize, text_font_family=fontFamily)
    table.cell(target, 1, row, value, text_color=valueColor, text_halign=text.align_right, text_size=textSize, text_font_family=fontFamily)

var table engineDashboard = table.new(f_dashboard_position(), 2, 9, bgcolor=dashboardBackground, border_width=1, border_color=dashboardBorder, frame_width=1, frame_color=dashboardBorder)
if barstate.islast
    if showDashboardInput
        dashboardTextSize = f_dashboard_size()
        string priceZoneText = close >= upper1000 ? "ABOVE RED" : close <= lower1000 ? "BELOW GREEN" : close >= basis ? "UPPER HALF" : "LOWER HALF"
        color priceZoneColor = close >= upper1000 ? ROSE : close <= lower1000 ? TEAL : color.silver
        string currentTouchText = greenBandTouched ? "GREEN TOUCH" : redBandTouched ? "RED TOUCH" : "NONE"
        color currentTouchColor = greenBandTouched ? TEAL : redBandTouched ? ROSE : color.silver
        string sessionText = inTradingSession ? "OPEN" : "CLOSED"
        color sessionColor = inTradingSession ? TEAL : ROSE
        string signalAgeText = na(barsSinceLastSignal) ? "—" : str.tostring(barsSinceLastSignal) + " bars"
        table.cell(engineDashboard, 0, 0, "GREEKS", bgcolor=dashboardHeader, text_color=color.white, text_halign=text.align_left, text_size=dashboardTextSize, text_font_family=dashboardFont)
        table.cell(engineDashboard, 1, 0, "FBB STRIKE ENGINE", bgcolor=dashboardHeader, text_color=color.silver, text_halign=text.align_right, text_size=dashboardTextSize, text_font_family=dashboardFont)
        f_greeks_row(engineDashboard, 1, "FBB Settings", str.tostring(fbbLengthInput) + " / " + str.tostring(fbbMultiplierInput), color.white, dashboardTextSize, dashboardFont)
        f_greeks_row(engineDashboard, 2, "Price Zone", priceZoneText, priceZoneColor, dashboardTextSize, dashboardFont)
        f_greeks_row(engineDashboard, 3, "Band Touch", currentTouchText, currentTouchColor, dashboardTextSize, dashboardFont)
        f_greeks_row(engineDashboard, 4, "Bull Signals Today", str.tostring(bullishGreenCount), TEAL, dashboardTextSize, dashboardFont)
        f_greeks_row(engineDashboard, 5, "Bear Signals Today", str.tostring(bearishRedCount), ROSE, dashboardTextSize, dashboardFont)
        f_greeks_row(engineDashboard, 6, "Last Signal", lastSignalText, lastSignalColor, dashboardTextSize, dashboardFont)
        f_greeks_row(engineDashboard, 7, "Signal Age", signalAgeText, color.silver, dashboardTextSize, dashboardFont)
        f_greeks_row(engineDashboard, 8, "Session", sessionText + " · 09:30–15:00 ET", sessionColor, dashboardTextSize, dashboardFont)
    else
        table.clear(engineDashboard, 0, 0, 1, 8)

// Bottom-of-chart branding: separate controls from the dashboard text.
var table brandingTable = table.new(position.bottom_center, 1, 1)
if barstate.islast
    if showFooterInput
        table.cell(brandingTable, 0, 0, footerTextInput, text_color=footerColorInput, text_size=footerSizeInput, text_font_family=footerFont, bgcolor=color.new(color.black, 100))
    else
        table.clear(brandingTable, 0, 0, 0, 0)

// ============================================================================
// ALERTS
//=====================================================================================================================
alertcondition(
     bullishGreenSignal,
     "GREEKS Bullish Green Touch / Cross",
     "Bullish candle touched or crossed the GREEN outer Fibonacci Bollinger Band.")
alertcondition(
     bearishRedSignal,
     "GREEKS Bearish Red Touch / Cross",
     "Bearish candle touched or crossed the RED outer Fibonacci Bollinger Band.")
alertcondition(
     bullishGreenBounce,
     "GREEKS Bullish Green Bounce",
     "Bullish candle touched/dipped through the GREEN band and recovered.")
alertcondition(
     bearishRedRejection,
     "GREEKS Bearish Red Rejection",
     "Bearish candle touched/pushed through the RED band and rejected.")
alertcondition(
     bullishGreenSignal or bearishRedSignal,
     "GREEKS Any Red / Green Signal",
     "GREEKS detected a bullish GREEN or bearish RED band interaction.")
